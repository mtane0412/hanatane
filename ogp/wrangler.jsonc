{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hanatane-ogp",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	// OGP 生成ルートがフォントと著者アイコンを静的アセットから読むためのバインディング
	"assets": {
		"binding": "ASSETS"
	},
	// Ghost Webhook 中継（/webhooks/ghost）が repository_dispatch を送る先。
	// GITHUB_DISPATCH_TOKEN と GHOST_WEBHOOK_TOKEN は `wrangler secret put` で登録する。
	"vars": {
		"GITHUB_REPOSITORY": "mtane0412/hanatane"
	}
}
