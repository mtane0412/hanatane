{# Caddyfile.j2
 # Caddy リバースプロキシ設定
 # Ansible テンプレートとして管理: Jinja2 変数（{{ }}、{% %}）は Ansible が展開し、
 # Caddy の環境変数参照（{$VAR}）はそのまま Caddy に渡される。
 # snippets/ は ./caddy/snippets/ 配下に配置されたファイルを参照する（ghost_network 経由）。
 #
 # Cloudflare 経由のアクセスに限定する:
 #   接続元（TCP の送信元）が cloudflare_ip_ranges（group_vars/all.yml）に含まれるリクエストだけを処理し、
 #   それ以外（origin への直アクセス）は応答を返さず切断する。
 #   trusted_proxies に同じ範囲を指定し、Cloudflare が付ける CF-Connecting-IP を実クライアント IP として扱う。
 #   訪問者が送る X-Forwarded-For は偽装できるため信用せず、上流へ渡す X-Forwarded-For を
 #   CF-Connecting-IP（Cloudflare が常に上書きする）から作り直す。Ghost はその左端の IP を
 #   ログイン試行の回数制限などに使う。
 #
 # セキュリティヘッダー:
 #   HSTS・nosniff・クリックジャッキング対策・Referrer-Policy を付与し、X-Powered-By を削除する。
 #}
{
    servers {
        trusted_proxies static {{ cloudflare_ip_ranges | join(' ') }}
        client_ip_headers CF-Connecting-IP
    }
}

{{ ghost_domain }}, www.{{ ghost_domain }} {
    # remote_ip は trusted_proxies の影響を受けず、常に TCP の接続元を判定する
    @cloudflare remote_ip {{ cloudflare_ip_ranges | join(' ') }}

    # セキュリティヘッダー（mg.hanatane.net 等のサブドメインに影響しないよう HSTS に includeSubDomains は付けない）
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -X-Powered-By
    }

    handle @cloudflare {
        # 偽装可能な X-Forwarded-For を検証済みのクライアント IP で置き換える（reverse_proxy が末尾に Cloudflare の IP を追記する）
        request_header X-Forwarded-For {client_ip}

{% if ghost_analytics_enabled %}
        import snippets/TrafficAnalytics
{% endif %}
{% if ghost_activitypub_enabled %}
        import snippets/ActivityPub
{% endif %}

        handle {
            reverse_proxy ghost:2368
        }
    }

    handle {
        abort
    }
}
