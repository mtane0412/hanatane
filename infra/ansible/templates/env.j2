{# env.j2
 # VPS 上の ~/ghost/.env テンプレート
 # 機密値は secrets/ghost.env（sops 暗号化済み）から ghost_secrets 変数経由で注入される。
 # このファイル自体に機密値は含まれない。
 #
 # COMPOSE_PROFILES のロジック:
 #   analytics  → ghost_analytics_enabled かつ TINYBIRD_TRACKER_TOKEN が存在する場合のみ。
 #                トークン未設定時は analytics プロファイルを有効化しない（tinybird-login が
 #                非対話モードで exit 1 し ghost の起動が阻害されるのを防ぐ）。
 #   activitypub → ghost_activitypub_enabled の場合。
 #}
{%- set _has_analytics_tokens = ghost_secrets.get('TINYBIRD_TRACKER_TOKEN', '') != '' -%}
{%- set _analytics_active = ghost_analytics_enabled and _has_analytics_tokens -%}
{%- set _profiles = [] -%}
{%- if _analytics_active -%}{%- set _ = _profiles.append('analytics') -%}{%- endif -%}
{%- if ghost_activitypub_enabled -%}{%- set _ = _profiles.append('activitypub') -%}{%- endif -%}
MYSQL_ROOT_PASSWORD={{ ghost_secrets['MYSQL_ROOT_PASSWORD'] }}
MAIL_AUTH_USER={{ ghost_secrets['MAIL_AUTH_USER'] }}
MAIL_AUTH_PASS={{ ghost_secrets['MAIL_AUTH_PASS'] }}
DOMAIN={{ ghost_domain }}
COMPOSE_PROFILES={{ _profiles | join(',') }}
{% if ghost_analytics_enabled %}
TINYBIRD_API_URL={{ ghost_secrets.get('TINYBIRD_API_URL', 'https://api.tinybird.co') }}
TINYBIRD_ADMIN_TOKEN={{ ghost_secrets.get('TINYBIRD_ADMIN_TOKEN', '') }}
TINYBIRD_WORKSPACE_ID={{ ghost_secrets.get('TINYBIRD_WORKSPACE_ID', '') }}
TINYBIRD_TRACKER_TOKEN={{ ghost_secrets.get('TINYBIRD_TRACKER_TOKEN', '') }}
{% endif %}
