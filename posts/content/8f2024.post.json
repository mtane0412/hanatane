							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "トークショー & KBDさんの生ライブ",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "extended-heading",
					"version": 1,
					"tag": "h2"
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "夜はハチエフゲスト達となぜか会場にいたDJ Shigeさんも加わってトークショーが始まりました。布団ちゃんは12年間作業療法士もされていたようで、今回のイベントに対する熱い気持ちも聞くことができてすっかりファンになってしました。なお、この後に盛岡のメンエスに行ったみたいです。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "embed",
					"version": 1,
