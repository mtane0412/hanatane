				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "動画にあった塩ビ管は太さも考えると1500~3000円位で思ったよりコストがかかりそう。",
							"type": "extended-text",
							"version": 1
						}
