					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "一方で1x4材は1820mmで高さも十分で1本500円。加工もしやすいので1x4材を基本に色々作ることにしました。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
