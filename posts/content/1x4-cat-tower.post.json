					"caption": "",
					"cardWidth": "regular",
					"href": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "いい感じになりました。元ドア枠部分なのであまり工夫せずにパワーでねじ込んで固定しています。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "このキャットタワーを使って上までの登ったらキャットウォークを追加でつけていって上の空間を活かす予定。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "最初はこの動画みたいに猫じゃらしで誘導してあげたら好んで爪とぎしてくれるようになりました。",
							"type": "extended-text",
							"version": 1
						}
