					"width": 4284,
					"height": 5712,
					"title": "",
					"alt": "",
					"caption": "",
					"cardWidth": "regular",
					"href": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "ちょうど洗面所と廊下を区切るアルミドアを撤去したので、元々ある鴨居の溝にはめ込むことしました。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "image",
					"version": 1,
					"src": "https://hanatane.net/content/images/2026/01/IMG_7200.jpeg",
					"width": 4032,
					"height": 3024,
					"title": "",
					"alt": "",
					"caption": "",
					"cardWidth": "regular",
					"href": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "鴨居のサイズを測って削ったつもりがこうなりました。私はバカです。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "仕方がないので溝をずらします。固定力は十分そう。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "image",
					"version": 1,
					"src": "https://hanatane.net/content/images/2026/01/IMG_7201.jpeg",
					"width": 4284,
					"height": 5712,
					"title": "",
					"alt": "",
					"caption": "",
					"cardWidth": "regular",
					"href": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "麻ロープを巻いていきます。適当な場所から始めてひたすらまきまき。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "最初と終わりは動画に倣ってビスを打ち込んでます。1x4材なら穴を開けてロープを通してコブを作るのも良さそうですね。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "完成",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "extended-heading",
					"version": 1,
					"tag": "h2"
				},
				{
					"type": "image",
					"version": 1,
