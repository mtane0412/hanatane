						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "設置第1号は猫の爪とぎ被害の大きいトイレ横に決定。ここの柱を登るのも大好き。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "image",
					"version": 1,
