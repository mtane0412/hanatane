	"excerpt": "gogcliにいたく感動したのでGhost版を作った話",
	"feature_image": "https://hanatane.net/content/images/2026/02/generation-513c6d07-ced5-4ba0-83a8-b591e94d49dc.png",
	"featured": false,
	"published_at": "2026-02-08T14:43:50.000Z",
