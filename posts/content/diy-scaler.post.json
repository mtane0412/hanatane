					"width": 3024,
					"height": 4032,
					"title": "",
					"alt": "",
					"caption": "",
					"cardWidth": "regular",
					"href": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "とりあえず珪藻土バスマットにつけてみます。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "image",
					"version": 1,
					"src": "https://hanatane.net/content/images/2023/11/IMG_4374.jpeg",
					"width": 3024,
					"height": 4032,
					"title": "",
					"alt": "",
					"caption": "",
					"cardWidth": "regular",
					"href": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "ここでテストしてたのですがどうも全然重さをとっていないみたいです。仕様書を見ると長辺50cmを超えちゃダメとあったので別の板でもやってみたのですが、変わらず。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "今回接続しているのはGrove端子という「4端子の汎用コネクタ」らしいです。M5StackではA, B, Cの三種類あって本体横のはport A。サンプルプログラムはport Bなのでうまくいっていないようでした。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "なーんだと思ったら電子工作詳しい人がサンプルプログラムのピン番号を変えれば動くよと教えてくれたので、そのとおりにやったら動きました。Lチカから入らずにいきなり体重計作ろうとしてる弊害ですね。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "ともかく最初の入門として体重計っぽものができました。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "embed",
					"version": 1,
