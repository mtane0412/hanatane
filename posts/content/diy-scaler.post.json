							"mode": "normal",
							"style": "",
							"text": "があったので、",
							"type": "extended-text",
							"version": 1
						},
						{
							"children": [
								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "M5 Scale Kit",
									"type": "extended-text",
									"version": 1
								}
							],
