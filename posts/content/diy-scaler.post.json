						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "をポチって作ってみることにしました。",
							"type": "extended-text",
							"version": 1
						},
						{
							"children": [
								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "先人の例",
									"type": "extended-text",
									"version": 1
								}
