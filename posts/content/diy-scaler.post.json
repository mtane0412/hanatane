						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "表の構成を見ながらポチポチ繋いでいきます。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
