								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "動き",
									"type": "text",
									"version": 1
								}
							],
							"direction": "ltr",
							"format": "",
							"indent": 0,
							"type": "link",
							"version": 1,
							"rel": null,
							"target": null,
							"title": null,
							"url": "https://www.nikkei.com/article/DGXZQOUC208S50Q3A420C2000000/"
						},
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "はとてもいいなと思った。底に合わせてシステムが作られている以上、底上げするしかないし、社内デジタル介護が減るだけでもかなり助かりそう。",
							"type": "text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
