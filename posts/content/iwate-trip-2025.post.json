					"href": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "対岸の団子屋からロープで団子が配送されてくる郭公だんごが名物。水曜どうでしょうで見たやつ。",
							"type": "extended-text",
							"version": 1
						}
