					"url": "https://x.com/mtane0412/status/1992459603779678403",
					"embedType": "twitter",
					"html": "<blockquote class=\"twitter-tweet\"><p lang=\"ja\" dir=\"ltr\">給餌機と給水機インストールした <a href=\"https://t.co/Daqm7OMwEV\">pic.twitter.com/Daqm7OMwEV</a></p>&mdash; たねのぶ (@mtane0412) <a href=\"https://twitter.com/mtane0412/status/1992459603779678403?ref_src=twsrc%5Etfw\">November 23, 2025</a></blockquote>\n<script async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"></script>\n\n",
					"metadata": {
						"url": "https://twitter.com/mtane0412/status/1992459603779678403",
						"author_name": "たねのぶ",
