						"title": "Stone tools in northern Europe made by Homo sapiens 45,000 years ago",
						"description": "Homo sapiens associated with a 45,000-year-old type of stone tool.",
						"author": "William E. Banks",
						"publisher": "Nature",
						"thumbnail": "https://media.nature.com/lw1024/magazine-assets/d41586-024-00072-1/d41586-024-00072-1_26671604.png"
