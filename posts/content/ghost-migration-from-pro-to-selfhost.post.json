				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "iPhoneから直接アップロードして適当に切り抜いてと便利ではあるのですが、今回は一旦見送りました。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
