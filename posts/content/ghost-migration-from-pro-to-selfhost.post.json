						},
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "が用意されています。ライフタイムといっても1年間のアップデートに限られているので何回か購入し直すような形になるでしょう。",
							"type": "extended-text",
							"version": 1
						}
