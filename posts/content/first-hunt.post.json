				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "罠ごとに標識を作成する必要がある。県ごとにテンプレートや例があるので",
							"type": "extended-text",
							"version": 1
						},
						{
							"children": [
								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "岩手県の例",
