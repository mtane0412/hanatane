					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "どのみちまずは餌に慣れさせる必要があると思ったので数日は餌付け期間なので大きさをチェックしてまた罠を購入し直すという段取りでとりあえず設置してみた。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "餌は前にネズミを捕まえたときにも活躍した",
							"type": "extended-text",
							"version": 1
						},
						{
							"children": [
								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "カルビーのフルグラ",
									"type": "extended-text",
									"version": 1
								}
							],
							"direction": "ltr",
							"format": "",
							"indent": 0,
							"type": "link",
							"version": 1,
							"rel": "noreferrer",
							"target": null,
							"title": null,
							"url": "https://amzn.to/3ZiRcdo"
						},
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "。香りも強いし自分で食ってもうまい。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
