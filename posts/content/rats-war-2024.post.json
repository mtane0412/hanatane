						"width": 550,
						"height": null,
						"type": "twitter",
						"cache_age": "3153600000",
						"provider_name": "Twitter",
						"provider_url": "https://twitter.com",
						"version": "1.0"
					},
					"caption": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "キッチンのステンレスラックがプロテインまみれになっていて何事だと思ったら、穴があいてて中身が散乱していた。過去にもプロテイン食ってたのに気づかずにプロテイン飲んでて体調を崩してたことがあったのでネズミの侵入を確信。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "余っていた",
							"type": "extended-text",
							"version": 1
						},
						{
							"children": [
								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "AtomCam 2",
									"type": "extended-text",
									"version": 1
								}
							],
							"direction": "ltr",
							"format": "",
							"indent": 0,
							"type": "link",
							"version": 1,
							"rel": "noreferrer",
							"target": null,
							"title": null,
							"url": "https://amzn.to/40YCCsL"
						},
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "をキッチンに設置。初動で侵入経路はっきり特定すればよかったのだけどこの日はカメラ設置して満足して終了。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "2024/11/16 ネズミの侵入を確認、罠設置",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "extended-heading",
					"version": 1,
					"tag": "h2"
				},
				{
					"type": "embed",
					"version": 1,
					"url": "https://x.com/mtane0412/status/1857689165712031862",
					"embedType": "twitter",
					"html": "<blockquote class=\"twitter-tweet\"><p lang=\"ja\" dir=\"ltr\">ねずみの侵入を確信したのでこれより戦争をはじめる😡 <a href=\"https://t.co/v9LJKGzEnf\">pic.twitter.com/v9LJKGzEnf</a></p>&mdash; たねのぶ (@mtane0412) <a href=\"https://twitter.com/mtane0412/status/1857689165712031862?ref_src=twsrc%5Etfw\">November 16, 2024</a></blockquote>\n<script async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"></script>\n\n",
					"metadata": {
						"url": "https://twitter.com/mtane0412/status/1857689165712031862",
						"author_name": "たねのぶ",
						"author_url": "https://twitter.com/mtane0412",
						"html": "<blockquote class=\"twitter-tweet\"><p lang=\"ja\" dir=\"ltr\">ねずみの侵入を確信したのでこれより戦争をはじめる😡 <a href=\"https://t.co/v9LJKGzEnf\">pic.twitter.com/v9LJKGzEnf</a></p>&mdash; たねのぶ (@mtane0412) <a href=\"https://twitter.com/mtane0412/status/1857689165712031862?ref_src=twsrc%5Etfw\">November 16, 2024</a></blockquote>\n<script async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"></script>\n\n",
						"width": 550,
						"height": null,
						"type": "twitter",
						"cache_age": "3153600000",
						"provider_name": "Twitter",
						"provider_url": "https://twitter.com",
						"version": "1.0"
					},
					"caption": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "今度は小麦粉が食い破られたのでいよいよネズミを捕獲しにかかることにした。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "Atom Cam 2の録画をまずは確認したところ、感度を最低にしていたので自動録画には残っていなかった。(感度最高だと結構ご検知もうるさい)",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "というわけで先に侵入経路を特定した。ここには前の持ち主の時代に電気温水器が設置されていて、その排水を隣のお風呂に通すために塩ビ管が通してあったのだが、ゴミ箱をどかしてみるとネズミが通れるくらいの穴が空けられていた。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "image",
					"version": 1,
					"src": "https://hanatane.net/content/images/2024/11/image-1.png",
					"width": 1000,
					"height": 750,
					"title": "",
					"alt": "",
					"caption": "",
					"cardWidth": "regular",
					"href": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "そして、近くにネズミがかじった1日分の野菜が落ちていたのでほぼここで確定。(こういうのをラットサインというらしい。)カメラの画角にこの1日分の野菜が映っていたので、これが現れるタイミングまで録画を遡ってネズミを初めて確認できた。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "video",
					"version": 1,
					"src": "https://hanatane.net/content/media/2024/11/trim_BF6B1937-15A1-48EB-B420-B7AF5EC173ED.MP4",
					"caption": "",
					"fileName": "trim_BF6B1937-15A1-48EB-B420-B7AF5EC173ED.MP4",
					"mimeType": "video/mp4",
					"width": 1906,
					"height": 1080,
					"duration": 45.955,
					"thumbnailSrc": "https://hanatane.net/content/media/2024/11/trim_BF6B1937-15A1-48EB-B420-B7AF5EC173ED_thumb.jpg",
					"customThumbnailSrc": "",
					"thumbnailWidth": 1906,
					"thumbnailHeight": 1080,
					"cardWidth": "regular",
					"loop": false
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "侵入経路も確定したのでとりあえずホームセンターから",
							"type": "extended-text",
							"version": 1
						},
						{
							"children": [
								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "粘着シート",
									"type": "extended-text",
									"version": 1
								}
							],
							"direction": "ltr",
							"format": "",
							"indent": 0,
							"type": "link",
							"version": 1,
							"rel": "noreferrer",
							"target": null,
							"title": null,
							"url": "https://amzn.to/3CHZItK"
						},
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "を買ってきて設置。真上から観察できるようにAtom Camも移動。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "image",
					"version": 1,
					"src": "https://hanatane.net/content/images/2024/11/IMG_5312.jpeg",
					"width": 4284,
					"height": 5712,
					"title": "",
					"alt": "",
					"caption": "",
					"cardWidth": "regular",
					"href": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "前回ネズミを捕まえたときは侵入経路に粘着シートを置いたらすぐに捕まったので期待。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "2024/11/18 粘着シート作戦失敗",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "extended-heading",
					"version": 1,
					"tag": "h2"
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "深夜に建物を走って「カリカリ」とかじる音を聞いたのでAtomCam2の映像をリアルタイムに監視。ネズミが顔を出したので期待したものの、かなり警戒している様子で粘着シートを避けて侵入してすぐに去った。シートの上に餌を置かなかったのも反省点。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "embed",
					"version": 1,
					"url": "https://x.com/mtane0412/status/1858289397034361326",
