					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "embed",
					"version": 1,
					"url": "https://x.com/mtane0412/status/1859937945064755297",
					"embedType": "twitter",
					"html": "<blockquote class=\"twitter-tweet\"><p lang=\"ja\" dir=\"ltr\">ねずみ戦争2024 終戦 <a href=\"https://t.co/pXcR0FHDSL\">pic.twitter.com/pXcR0FHDSL</a></p>&mdash; たねのぶ (@mtane0412) <a href=\"https://twitter.com/mtane0412/status/1859937945064755297?ref_src=twsrc%5Etfw\">November 22, 2024</a></blockquote>\n<script async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"></script>\n\n",
					"metadata": {
						"url": "https://twitter.com/mtane0412/status/1859937945064755297",
						"author_name": "たねのぶ",
						"author_url": "https://twitter.com/mtane0412",
