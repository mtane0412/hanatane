					"caption": "",
					"cardWidth": "regular",
					"href": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "自分を除外する",
							"type": "extended-text",
							"version": 1
