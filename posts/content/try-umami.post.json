					"type": "codeblock",
					"version": 1,
					"code": "localStorage.setItem('umami.disabled', 1);",
					"language": "shell",
					"caption": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "外部リンクを記録する",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "extended-heading",
					"version": 1,
					"tag": "h3"
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "Umamiにもイベントトラッキング機能があります。細かいイベントを記録することもできますが、さしあたっては外部リンクを踏んだイベントをガイド通りに導入。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "codeblock",
					"version": 1,
					"code": "<script type=\"text/javascript\">\n  (() => {\n    const name = 'outbound-link-click';\n    document.querySelectorAll('a').forEach(a => {\n      if (a.host !== window.location.host && !a.getAttribute('data-umami-event')) {\n        a.setAttribute('data-umami-event', name);\n        a.setAttribute('data-umami-event-url', a.href);\n      }\n    });\n  })();\n</script>",
					"language": "html",
					"caption": ""
				},
