				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "時をしばらくして",
							"type": "extended-text",
							"version": 1
						},
						{
							"children": [
								{
									"detail": 0,
									"format": 0,
