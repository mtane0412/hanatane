							"target": null,
							"title": null,
							"url": "https://toggl.com/"
						},
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "がポモドーロタイマーを出していたのでまず第一候補だったのですが、Togglはツールの思想上すべての時間管理に手を出してしまいがちになってしまうことや、ポモドーロ機能も内部的には通常のTogglタイマーを使用しており、Apple Watchで見たときには通常のタイマー表示になっているという部分にオアアアー！となってしまったので見送りです。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": null,
					"format": "",
