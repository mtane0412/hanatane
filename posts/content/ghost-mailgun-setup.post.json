						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "対策を調べるとGhost側ではメール送信のバッチサイズを設定できるオプションがあるらしい。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
