						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "Dockerのログを確認してみます。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
