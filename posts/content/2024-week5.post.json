							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "もう一つは最近亡くなってしまった山崎元さんの記事。これもわかりやすいレベルに落としてくれているので読みやすい。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
