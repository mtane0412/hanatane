				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "他のプログラムから制御できるようにしたいのでHTTPサーバーでリクエストを受けるようにしました。このあたりは今はChatGPTがサクっと書いてくれるので非常に助かります。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "工夫しどころとして、",
							"type": "extended-text",
							"version": 1
						},
						{
							"detail": 0,
							"format": 16,
							"mode": "normal",
							"style": "",
							"text": "http://pi5のローカルアドレス:5000/control",
							"type": "extended-text",
							"version": 1
						},
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "にMaBeeeのMacアドレスとPWMの値をペイロードにしてPOSTリクエストをして任意のMaBeeを操作できるように少し汎用性を持たせてあります。あとはBluetooth通信が不安定なときのために何回かリトライもさせるようにしました。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "codeblock",
					"version": 1,
					"code": "import time\nfrom flask import Flask, request, jsonify\nfrom bluepy import btle\n\napp = Flask(__name__)\n\ndef connect(mac_addr, retries=3, delay=5):\n    for attempt in range(retries):\n        try:\n            peripheral = btle.Peripheral()\n            peripheral.connect(mac_addr, btle.ADDR_TYPE_RANDOM)\n            return peripheral\n        except Exception as e:\n            if attempt < retries - 1:\n                time.sleep(delay)\n            else:\n                raise e\n\ndef write_pwm(peripheral, value):\n    PWM_HANDLE = 17\n    PWM_INDEX = 1\n    data = bytearray(peripheral.readCharacteristic(PWM_HANDLE))\n    data[PWM_INDEX] = value\n    peripheral.writeCharacteristic(17, bytes(data), True)\n\n@app.route('/control', methods=['POST'])\ndef control_device():\n    data = request.json\n    if 'mac_addr' not in data or 'pwm_value' not in data:\n        return jsonify({'error': 'Invalid input'}), 400\n\n    mac_addr = data['mac_addr']\n    pwm_value = int(data['pwm_value'])\n\n    if not (0 <= pwm_value <= 100):\n        return jsonify({'error': 'PWM value must be between 0 and 100'}), 400\n\n    try:\n        peripheral = connect(mac_addr)\n        write_pwm(peripheral, pwm_value)\n        peripheral.disconnect()\n        return jsonify({'status': 'success'}), 200\n    except Exception as e:\n        return jsonify({'error': str(e)}), 500\n\nif __name__ == '__main__':\n    app.run(host='0.0.0.0', port=5000)",
					"language": "python",
					"caption": ""
				},
