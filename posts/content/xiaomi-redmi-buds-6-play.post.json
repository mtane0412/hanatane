</span>\n      </div>\n      \n    </div>\n  </a>\n</div>\n\n<style>\n@media (max-width: 600px) {\n  .amazon-link-card a {\n    flex-direction: column !important;\n  }\n  .amazon-link-card a > div:first-child {\n    flex: 0 0 auto !important;\n    padding: 20px !important;\n  }\n}\n</style>",
