						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "しばらくドタバタしていて更新おやすみしておりました。",
							"type": "text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
