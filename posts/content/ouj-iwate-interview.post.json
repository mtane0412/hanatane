							"mode": "normal",
							"style": "",
							"text": "ポゴパーカーを着て何らかの媒体に出るのが人生の目標のだったのであとは余生をゆっくり過ごすだけとなった。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
