							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "GhostのAmazonリンクが壊れている問題",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
