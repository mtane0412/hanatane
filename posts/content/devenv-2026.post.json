							"text": "CodeRabbit CLI",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "extended-heading",
					"version": 1,
					"tag": "h2"
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "PR実行前に",
							"type": "extended-text",
							"version": 1
						},
						{
							"detail": 0,
							"format": 16,
							"mode": "normal",
							"style": "",
							"text": "coderabbit --prompt-only",
							"type": "extended-text",
							"version": 1
						},
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": " でCodeRabbit CLIを実行してレビューに対応するようにルール付けしている。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "CodeRabbitはClaude Codeのレビューでも拾わないところを拾ってくれるのでよい。同時並行開発時の悩みはしょっちゅうRate Limitに引っかかることで、CLIのlimitは課金しても大して増えないので課金のモチベーションが湧かない。(あくまでGithub上のPRレビューがメインなのだろう)",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "bookmark",
					"version": 1,
					"url": "https://www.coderabbit.ai/ja/cli",
					"metadata": {
						"icon": "https://hanatane.net/content/images/icon/favicon-27.ico",
						"title": "CodeRabbit: AI Code Reviews",
						"description": "CodeRabbit: AI Code Reviews",
						"author": "",
						"publisher": "",
						"thumbnail": "https://hanatane.net/content/images/thumbnail/image-1"
					},
					"caption": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "修正後もcoderabbitを実行するとすぐにlimitに達してしまうので一度だけ聞いて対応してそのままPRに進むようにしている。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "PRスコープ外のnitpikに関してgithub issue化するようなルール付けも良いなと思ったのだが、作業量が多くなったので最近はそこまではやっていない。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "Lefthook",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "extended-heading",
					"version": 1,
					"tag": "h2"
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "Claudeへのルール付けでたまに漏れることもあるので、大きなプロジェクトだとLefthookを使ってpre-commit hookでLintとテストが走るようにしている。huskyでもよかったが、モノレポで複数言語だったのでLefthookがちょうどよさそうだった。(dd2030で使われてたので知ってた。)",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "bookmark",
					"version": 1,
					"url": "https://github.com/evilmartians/lefthook",
					"metadata": {
						"icon": "https://hanatane.net/content/images/icon/pinned-octocat-093da3e6fa40-9.svg",
						"title": "GitHub - evilmartians/lefthook: Fast and powerful Git hooks manager for any type of projects.",
						"description": "Fast and powerful Git hooks manager for any type of projects. - evilmartians/lefthook",
						"author": "evilmartians",
						"publisher": "GitHub",
						"thumbnail": "https://hanatane.net/content/images/thumbnail/0bf8ef80-96c8-11e9-98c4-5c275172132d"
					},
					"caption": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "ちなみにClaudeはこのチェックを隙あらば迂回しようとしてくるのでルールで潰す。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "Claude Code Actions",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "extended-heading",
					"version": 1,
					"tag": "h2"
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 16,
							"mode": "normal",
							"style": "",
							"text": "/install-github-app",
							"type": "extended-text",
							"version": 1
						},
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": " でClaude CodeをGithubリポジトリに住まわせることができる。issueやPR上で@claudeで作業させられるようになるが、メインはPRのレビュー。CodeRabbitはプライベートリポジトリでは有料版が必要なのでMaxプランで動いてくれるClaudeは本当に心強い。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "bookmark",
					"version": 1,
					"url": "https://code.claude.com/docs/ja/github-actions",
					"metadata": {
						"icon": "https://hanatane.net/content/images/icon/apple-touch-icon-11.png",
						"title": "Claude Code GitHub Actions - Claude Code Docs",
						"description": "Claude Code GitHub Actionsを開発ワークフローに統合する方法について学びます",
						"author": "",
						"publisher": "Claude Code Docs",
						"thumbnail": "https://hanatane.net/content/images/thumbnail/image-2"
					},
					"caption": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "結局Claudeで実行するならローカルでも良いのでは？となるが、ローカルではCodeRabbitがメインのレビュアーで、ActionsのClaudeはApprove判断を行うという役割分担になっている。5並列くらいで回していると、PR作成してGithub上で各種CIやレビューが走っている間に他のプロセスを見たりするのでちょうど良い。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "Github Copilot Pro",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "extended-heading",
					"version": 1,
					"tag": "h2"
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "そういえば放送大学生なのでGithub Copilot Proが無料で使えるなと思ってまたGithub Educationに再登録した。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "Copilot ProもPR上で細かい改善点をレビューしてくれる。Coderabbit, Copilot, Claudeの謎の多重チェック体制となっている。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "bookmark",
					"version": 1,
					"url": "https://docs.github.com/ja/copilot/how-tos/manage-your-account/get-free-access-to-copilot-pro",
					"metadata": {
						"icon": "https://hanatane.net/content/images/icon/favicon-1.png",
						"title": "学生、教師、またはメンテナンス担当として GitHub Copilot Pro に無料でアクセスする - GitHub ドキュメント",
						"description": "学生、教師、またはオープンソースのメンテナンス担当として Copilot Pro を無料で使用する方法について説明します。",
						"author": "",
						"publisher": "GitHub Docs",
						"thumbnail": "https://hanatane.net/content/images/thumbnail/copilot.png"
					},
					"caption": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "Copilot Proはweekly limitに達した時とかにopen codeを使うときにも活躍してくれそう。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "opencode",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "extended-heading",
					"version": 1,
					"tag": "h2"
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "Claude Codeで同時並行で起きてる間ずっと回していたらweekly limitに達してしまった。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "2日間ほど強制的な絶状態を味わったのだけど、その間に触ったのがopencodeで完成度も良さそうだった。ChatGPT PlusやCopilot Proのサブスクリプションがあるのでweekly limitに達した後や、特定タスクに関してはClaude Maxの枠を使わずにこちらで対処するのもありなのかなと思っている。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "Claudeの資産をそのまま使えるのが強く、Agent Skillはそのまま使えるし、AGENTS.mdはClaude CodeのCLAUDE.mdにシンボリックリンクを貼ればOK。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"type": "bookmark",
					"version": 1,
					"url": "https://github.com/anomalyco/opencode",
					"metadata": {
						"icon": "https://hanatane.net/content/images/icon/pinned-octocat-093da3e6fa40-12.svg",
						"title": "GitHub - anomalyco/opencode: The open source coding agent.",
						"description": "The open source coding agent. Contribute to anomalyco/opencode development by creating an account on GitHub.",
						"author": "anomalyco",
						"publisher": "GitHub",
						"thumbnail": "https://hanatane.net/content/images/thumbnail/2c2c3389-c647-405c-a499-f80e4d521277"
					},
					"caption": ""
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "まとめ",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "extended-heading",
					"version": 1,
					"tag": "h2"
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "同時並行開発を実際にやってみると、想像していたことと真逆のことが起きていた。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"children": [
								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "認知的にすぐパンクすると思っていたら、人間とagentの役割がより明確に分離したので人間は凄まじい過集中状態になった。",
									"type": "extended-text",
									"version": 1
								}
							],
							"direction": "ltr",
							"format": "",
							"indent": 0,
							"type": "listitem",
							"version": 1,
							"value": 1
						},
						{
							"children": [
								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "何が起きているのかわからなくなると思っていたら、プランニングからapproveまで明確な説明がgitのログに残るようになったのでかなり把握できるようになった。分からないことはその場で聞けば詳細に調べられるし。",
									"type": "extended-text",
									"version": 1
								}
							],
							"direction": "ltr",
							"format": "",
							"indent": 0,
							"type": "listitem",
							"version": 1,
							"value": 2
						},
						{
							"children": [
								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "知識がものすごい勢いで増えていく。検討中にClaudeとディスカッションすると新奇の概念に触れることが多く、なぜそれが今必要なのか/必要でないのかという文脈つきで入ってくるので吸収がとても良い。",
									"type": "extended-text",
									"version": 1
								}
							],
							"direction": "ltr",
							"format": "",
							"indent": 0,
							"type": "listitem",
							"version": 1,
							"value": 3
						},
						{
							"children": [
								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "肥大化するCLAUDE.mdを定期的にリファクタリングして、ruleやskillなど再利用可能な単位になっていくのが気持ちいい。",
									"type": "extended-text",
									"version": 1
								}
							],
							"direction": "ltr",
							"format": "",
							"indent": 0,
							"type": "listitem",
							"version": 1,
							"value": 4
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "list",
					"version": 1,
					"listType": "bullet",
					"start": 1,
					"tag": "ul"
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "なんというか「自分はエンジニアじゃないので〜」という免罪符を振りかざす層がAgentic Codingの一番うまい蜜を啜ってる層な気がしていて、同時に事故るときに一番激しくなりそうなのでそこんとこ気をつけたいなと思っております。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				}
			],
			"direction": "ltr",
			"format": "",
			"indent": 0,
			"type": "root",
			"version": 1
		}
	}
}
