								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "エージェント用Githubアカウントを付与した。主に自宅関連のリポジトリを把握させる用。",
									"type": "extended-text",
									"version": 1
								}
							],
