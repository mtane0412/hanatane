							"direction": "ltr",
							"format": "",
							"indent": 0,
							"type": "listitem",
							"version": 1,
							"value": 11
						},
						{
							"children": [
								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "Discordのコネクタを作成した。常駐型に近づける振る舞いは少し面倒だったのでたまに投稿する感じにした。",
									"type": "extended-text",
									"version": 1
