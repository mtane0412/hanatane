								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "公式のWithingsコネクタを使って体重その他の情報を取れるようにした",
									"type": "extended-text",
									"version": 1
								}
							],
							"direction": "ltr",
							"format": "",
							"indent": 0,
							"type": "listitem",
