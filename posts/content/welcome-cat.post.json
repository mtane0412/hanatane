								{
									"detail": 0,
									"format": 0,
									"mode": "normal",
									"style": "",
									"text": "Amazonベーシックのケージ",
									"type": "extended-text",
									"version": 1
								}
							],
							"direction": "ltr",
							"format": "",
							"indent": 0,
							"type": "link",
							"version": 1,
							"rel": "noreferrer",
							"target": null,
							"title": null,
