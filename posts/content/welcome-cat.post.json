						},
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "をセットアップしたものの、現状もトイレ以外ではあまり使われず。むしろケージを足場にして高い位置のカーテンの後ろに隠れるようになった。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
