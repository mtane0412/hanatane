				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "4日目に向こうも徐々に接近するようになってきたのでチュールで一気に近づく作戦決行。",
							"type": "extended-text",
							"version": 1
						}
					],
