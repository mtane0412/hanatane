						},
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "に友達に誘われたので出てました。種目はストリートファイター6の5on5。ポゴレジェとほぼレジェで挑みました。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
