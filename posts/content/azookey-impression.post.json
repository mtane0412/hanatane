						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "文字を生成する魔法のような技術の勃興期に、なぜ僕らは漢字の変換候補をちまちま探してるのか。azooKeyというIMEがこの地獄から救ってくれそうなので紹介したい。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "なんか凄そうだぞazooKey",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "extended-heading",
					"version": 1,
					"tag": "h2"
				},
				{
					"children": [
						{
							"detail": 0,
							"format": 0,
							"mode": "normal",
							"style": "",
							"text": "MacでもWindowsでもIMEはGoogle日本語入力を何年も使っていたのだが、azooKeyというIMEを使い始めた。",
							"type": "extended-text",
							"version": 1
						}
					],
					"direction": "ltr",
					"format": "",
					"indent": 0,
					"type": "paragraph",
					"version": 1
				},
